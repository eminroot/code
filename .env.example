# Copy to .env and fill in ONE provider. Restart `npx expo start` after editing.
# Without any key the coach still answers from the built-in guides.

# Pick one explicitly, or leave empty to use whichever key is set.
EXPO_PUBLIC_LLM_PROVIDER=

# Claude (default model: claude-opus-5-5)
EXPO_PUBLIC_ANTHROPIC_API_KEY=

# Gemini (default model: gemini-2.5-flash)
EXPO_PUBLIC_GEMINI_API_KEY=

# Any OpenAI-compatible endpoint, e.g. a hackathon-provided API
EXPO_PUBLIC_OPENAI_API_KEY=
EXPO_PUBLIC_OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: override the model name for the chosen provider
EXPO_PUBLIC_LLM_MODEL=
